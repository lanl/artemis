<artemis>
problem = plasmoid_mhd          # name of the pgen
coordinates = cartesian  # coordinate system

<parthenon/job>
problem_id = plasmoid_mhd  # problem ID: basename of output filenames

<parthenon/output1>
variables = gas.prim.density,  &
            gas.prim.velocity, &
            gas.prim.pressure, &
	    gas.prim.Bfield, &   # I can compare to fcc to validate
	    gas.cons.divB, &
	    gas.face.bfield, &
	    gas.edge.J
file_type = hdf5  # HDF5 data dump
dt        = 1.0   # time increment between outputs
ncycle    = 1

<parthenon/time>
nlim       = -1  # cycle limit
tlim       = 300.0  # time limit
integrator = rk2  # time integration algorithm
ncycle_out = 100  # interval for stdout summary info

<parthenon/mesh>
nghost = 2
#refinement = adaptive
#numlevel = 3

nx1    = 2000       # Number of zones in X1-direction
x1min  = 0.0       # minimum value of X1
x1max  = 200.0       # maximum value of X1
ix1_bc = sym        
ox1_bc = outflow        

nx2    = 1500         # Number of zones in X2-direction
x2min  = 0.0       # minimum value of X2
x2max  = 150.0       # maximum value of X2
ix2_bc = sym  # inner-X2 boundary flag
ox2_bc = conducting  # outer-X2 boundary flag

nx3    = 1         # Number of zones in X3-direction
x3min  = 0.0       # minimum value of X3
x3max  = 1.0       # maximum value of X3
ix3_bc = periodic  # inner-X3 boundary flag
ox3_bc = periodic  # outer-X3 boundary flag

<parthenon/meshblock>
nx1 = 250    # Number of cells in each MeshBlock, X1-dir
nx2 = 250    # Number of cells in each MeshBlock, X2-dir
nx3 = 1      # Number of cells in each MeshBlock, X3-dir

<physics>
gas = true
mhd = true

<gas>
gamma = 1.66666667   # adiabatic index
cfl = 0.45           # CFL number
reconstruct = plm   # reconstruction algorithm
riemann = hlld      # Riemann solver
dfloor = 1.0e-10
siefloor = 1.0e-10
refine_field = pressure
refine_type = gradient
refine_thr = 0.6

<problem>
beta_up = 0.2 # middle region
