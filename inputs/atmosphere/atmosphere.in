<artemis>
problem = atmosphere          # name of the pgen
coordinates = cartesian  # coordinate system
physical_units = cgs     # not scale-free
unit_conversion = base
length = 1e5  # km
mass = 1e15  # 1 g/cc = 1e15 g/km^3


<parthenon/job>
problem_id = atmo  # problem ID: basename of output filenames

<parthenon/output1>
variables = gas.prim.density,  &
            gas.prim.velocity, &
            gas.prim.temperature, &
            gas.prim.pressure
file_type = hdf5  # HDF5 data dump
dt        = 0.1  # time increment between outputs

<parthenon/time>
nlim       = -1.0     # cycle limit
tlim       = 1.0  # time limit
integrator = rk2    # time integration algorithm
ncycle_out = 1    # interval for stdout summary info

<parthenon/mesh>
# nghost = 2
# refinement = adaptive
# numlevel = 4

nx1    = 128     # Number of zones in X1-direction
x1min  = -1.0    # minimum value of X1
x1max  = 1.0     # maximum value of X1
ix1_bc = extrap  # Inner-X1 boundary condition flag
ox1_bc = extrap  # Outer-X1 boundary condition flag

nx2    = 1     # Number of zones in X2-direction
x2min  = -0.5    # minimum value of X2
x2max  = 0.5     # maximum value of X2
ix2_bc = periodic  # Inner-X2 boundary condition flag
ox2_bc = periodic  # Outer-X2 boundary condition flag

nx3    = 1       # Number of zones in X3-direction
x3min  = -0.5    # minimum value of x3
x3max  = 0.5     # maximum value of x3
ix3_bc = periodic  # Inner-x3 boundary condition flag
ox3_bc = periodic  # Outer-x3 boundary condition flag

<parthenon/meshblock>
nx1 = 128  # Number of cells in each MeshBlock, X1-dir
nx2 = 1  # Number of cells in each MeshBlock, X2-dir
nx3 = 1   # Number of cells in each MeshBlock, X3-dir

<physics>
gas = true
gravity = true

<gas>
cfl = 0.3
reconstruct = plm
riemann = hllc-general
dfloor = 1.0e-15
siefloor = 1.0e-15


#<gas/eos/ideal>
#gamma = 1.6667
#mu = 1.0

<gas/eos/h-he>
x = 0.7
y = 0.3
nd = 200
nt = 50
ldmin = -10.0
ldmax = 1.0
ltmin = 1.0
ltmax = 3.0
save_to_file = eos.sp5


<gravity/linear>
# g = -Omega^2*x
# Omega = c_s / H
# c_s ~ 1.3 km/s @ 300 K
gx1 = 0.0
gx2 = 0.0
gx3 = 0.0
dgdx1 = -13.0  # H -> 0.1 km

<problem>
rho0 = 1.0  # g/cc
T0 = 300.0  # K
