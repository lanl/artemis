        "CMAKE_MAKE_PROGRAM": "$env{MAKE_PROGRAM}",
        "CMAKE_BUILD_TYPE": "Debug",
        "Kokkos_ENABLE_DEBUG_BOUNDS_CHECK": "ON",
        "CMAKE_C_COMPILER": "amdclang",
        "CMAKE_CXX_COMPILER": "amdclang++",
        "CMAKE_CXX_FLAGS": "--gcc-toolchain=$env{GCC_ROOT}",
